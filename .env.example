# Copy to .env.local and fill in. Never commit .env.local (it is git-ignored).

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon key: safe in the browser, all access is limited by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: bypasses RLS. Server only, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (test mode only; the app refuses non-test keys) ---
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` output (whsec_...). The Dashboard endpoint secret is different.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Zoho CRM (api-console.zoho.com -> Self Client) ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Generated once from a grant code with scope ZohoCRM.modules.ALL
ZOHO_REFRESH_TOKEN=
# Must match your Zoho data centre: .com / .eu / .in / .com.au / .jp / .ca
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
# Deal stage set after payment, and stage for newly seeded Deals (must exist in your Stage picklist)
ZOHO_PAID_STAGE=Closed Won
ZOHO_SEED_STAGE=Qualification
# Optional: API name of a custom single-line Deal field to store the Stripe PaymentIntent id
ZOHO_PAYMENT_ID_FIELD=
# Set to true to simulate a Zoho outage (CRM sync goes to failed, access is unaffected)
ZOHO_SIMULATE_DOWN=false

# --- App ---
APP_URL=http://localhost:3000
# Protects POST /api/crm/retry for operators. Generate: openssl rand -hex 32
ADMIN_TOKEN=
# Password given to the seeded test clients (alice@example.com, bob@example.com)
SEED_CLIENT_PASSWORD=
